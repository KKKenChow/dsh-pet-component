{
  "name": "dsh-pet-component",
  "type": "module",
  "version": "0.1.1",
  "packageManager": "pnpm@11.25.0",
  "description": "把 dsh-pet 与 Codex Pet 两套桌宠协议收进一个 <Pet> React 组件",
  "author": "Hairyf <wwu710632@gmail.com>",
  "license": "MIT",
  "funding": "https://github.com/sponsors/hairyf",
  "homepage": "https://github.com/hairyf/dsh-pet-component#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hairyf/dsh-pet-component.git"
  },
  "bugs": "https://github.com/hairyf/dsh-pet-component/issues",
  "keywords": [],
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts",
    "./package.json": "./package.json"
  },
  "types": "./dist/index.d.mts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "dev:playground": "cd playground && pnpm run dev",
    "lint": "eslint",
    "prepack": "nr build",
    "release": "bumpp",
    "start": "tsx src/index.ts",
    "test": "pnpm run build && vitest",
    "typecheck": "tsc",
    "prepare": "git config core.hooksPath .githooks && simple-git-hooks && skills-npm"
  },
  "scripts-info": {
    "build": "Build the library for publishing",
    "dev": "Rebuild on change during development",
    "lint": "Check for code style issues",
    "prepack": "Build before publishing",
    "release": "Bump version and publish a release",
    "start": "Run the entry file",
    "test": "Run the test suite",
    "typecheck": "Check types",
    "prepare": "Set up git hooks and skills"
  },
  "peerDependencies": {
    "react": "^19.0.0"
  },
  "dependencies": {
    "@reause/core": "catalog:",
    "@reause/integrations": "catalog:",
    "css-render": "catalog:",
    "idb-keyval": "catalog:"
  },
  "devDependencies": {
    "@antfu/eslint-config": "catalog:cli",
    "@antfu/ni": "catalog:cli",
    "@antfu/utils": "catalog:inlined",
    "@eslint-react/eslint-plugin": "catalog:",
    "@types/node": "catalog:types",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "bumpp": "catalog:cli",
    "eslint": "catalog:cli",
    "eslint-plugin-react-refresh": "catalog:",
    "eslint-plugin-slop": "catalog:cli",
    "eslint-plugin-sonarjs": "catalog:cli",
    "nano-staged": "catalog:cli",
    "publint": "catalog:cli",
    "react": "catalog:",
    "react-dom": "catalog:",
    "simple-git-hooks": "catalog:cli",
    "skills-npm": "catalog:cli",
    "tsdown": "catalog:cli",
    "tsdown-stale-guard": "catalog:testing",
    "tsnapi": "catalog:testing",
    "tsx": "catalog:cli",
    "typescript": "catalog:cli",
    "vite": "catalog:cli",
    "vitest": "catalog:testing"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm --config.manage-package-manager-versions=true i --frozen-lockfile --ignore-scripts --offline && pnpm run build && npx nano-staged"
  },
  "nano-staged": {
    "*.{js,cjs,mjs,jsx,ts,tsx,mts,cts,vue,json,jsonc,md,yml,yaml,toml}": "eslint --fix"
  },
  "publishConfig": {
    "exports": {
      ".": "./dist/index.mjs",
      "./package.json": "./package.json"
    }
  }
}
